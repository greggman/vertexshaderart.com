// rage by gman
// https://www.vertexshaderart.com/art/qShjbKXDhES9fS66n
//
// HLSL (vs_5_0) port of the GLSL ES 1.00 vertex shader in art.json,
// generated by build/gen-hlsl.js.
//
// Matrices hold the transpose of their GLSL counterparts so that column
// constructors and m[i] column indexing carry over unchanged; the
// difference lives in the multiplies, as HLSL's usual row vector
// convention (GLSL `M * v` is `mul(v, M)` here).

cbuffer VSAUniforms : register(b0) {
  float2 mouse;
  float2 resolution;
  float4 background;
  float  time;
  float  vertexCount;
  float2 soundRes;
  float  _dontUseDirectly_pointSize;
};

Texture2D<float4> volume     : register(t0);
Texture2D<float4> sound      : register(t1);
Texture2D<float4> floatSound : register(t2);
Texture2D<float4> touch      : register(t3);
SamplerState      vsaSampler : register(s0);

// gl_Position / gl_PointSize / v_color are globals here for the same reason
// they're globals in GLSL: helper functions in these shaders write to them.
static float  vertexId;
static float4 gl_Position;
static float  gl_PointSize = 1.0;
static float4 v_color;

// ---------------------------------------------------------------------

/*

               _                 _           _                    _  
              ( )               ( )         ( )                  ( ) 
 _ _  ___  __ | |  ___ __ __ __ | |_  ___  _| | ___  __  ___  __ | | 
( V )( o_)( _)( _)( o_)\ V /(_' ( _ )( o )/ o )( o_)( _)( o )( _)( _)
 \_/  \(  /_\ /_\  \(  /_^_\/__)/_\||/_^_\\___\ \(  /_\ /_^_\/_\ /_\ 
                                                                     



*/



#define NUM_POINTS (NUM_SEGMENTS * 2.0)
#define STEP 1.0
#define NUM_LINES_DOWN 64.0
#define PI radians(180.0)

float3 hsv2rgb(float3 c) {
  c = float3(c.x, clamp(c.yz, 0.0, 1.0));
  float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
  float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
  return c.z * lerp(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

// hash function from https://www.shadertoy.com/view/4djSRW
float hash(float p) {
	float2 p2 = frac(float2(p * 5.3983, p * 5.4427));
    p2 += dot(p2.yx, p2.xy + float2(21.5351, 14.3137));
	return frac(p2.x * p2.y * 95.4337);
}

float m1p1(float v) {
    return v * 2. - 1.;
}

void main() {
  float v = floor(vertexId / 2.0) / vertexCount * 2.;
  float u = sin(time * 0.001 + time * (vertexId + 1.) * 0.1) * 1.;
  
  
  
  
  // Only use the left most 1/4th of the sound texture
  // because there's no action on the right
  float historyX = hash(u) * 0.25 + 0.1;
  // Match each line to a specific row in the sound texture
  float historyV = v * 0.004;
  float snd1 = sound.SampleLevel(vsaSampler, float2(historyX, historyV), 0.0).a;
  float snd2 = sound.SampleLevel(vsaSampler, float2(historyX + 0.1, historyV), 0.0).a;
  float snd3 = sound.SampleLevel(vsaSampler, float2(0.1, v), 0.0).a;
  float2 off = float2(
    cos(snd1 * PI * 8.),
    sin(snd2 * PI * 6.4));

  float2 xy = float2(
      m1p1(hash(time + vertexId)),
      m1p1(hash(time + vertexId + 1.)));
//      snd1 * 2. - 1.,
//      snd2 * 2. - 1.);// * mix(1., -1., mod((time + vertexId * 0.1 + snd1) * 60., 2.));
  gl_Position = float4(xy * 0.1 + off, 0, 1);

  float hue = u;
  float sat = 0.;
  float val = 0.;
  v_color = float4(hsv2rgb(float3(hue, sat, val)), 1);
  v_color = lerp(v_color, float4(1,0,0,1), step(0.78, snd3));
  gl_PointSize = 4.;
}

// ---------------------------------------------------------------------

struct VSOutput {
  float4 position  : SV_Position;
  float4 color     : COLOR0;
  float  pointSize : PSIZE;
};

VSOutput vsMain(uint vertexIndex : SV_VertexID) {
  vertexId = (float)vertexIndex;
  main();

  VSOutput output;
  output.position  = gl_Position;
  output.color     = v_color;
  output.pointSize = gl_PointSize;
  return output;
}
