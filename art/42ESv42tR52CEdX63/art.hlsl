// targ by gman
// https://www.vertexshaderart.com/art/42ESv42tR52CEdX63
//
// HLSL (vs_5_0) port of the GLSL ES 1.00 vertex shader in art.json,
// generated by build/gen-hlsl.js.
//
// Matrices hold the transpose of their GLSL counterparts so that column
// constructors and m[i] column indexing carry over unchanged; the
// difference lives in the multiplies, as HLSL's usual row vector
// convention (GLSL `M * v` is `mul(v, M)` here).

cbuffer VSAUniforms : register(b0) {
  float2 mouse;
  float2 resolution;
  float4 background;
  float  time;
  float  vertexCount;
  float2 soundRes;
  float  _dontUseDirectly_pointSize;
};

Texture2D<float4> volume     : register(t0);
Texture2D<float4> sound      : register(t1);
Texture2D<float4> floatSound : register(t2);
Texture2D<float4> touch      : register(t3);
SamplerState      vsaSampler : register(s0);

// gl_Position / gl_PointSize / v_color are globals here for the same reason
// they're globals in GLSL: helper functions in these shaders write to them.
static float  vertexId;
static float4 gl_Position;
static float  gl_PointSize = 1.0;
static float4 v_color;

// GLSL mod() floors, HLSL fmod() truncates, so they disagree on negatives
float  glslMod(float  x, float  y) { return x - y * floor(x / y); }
float2 glslMod(float2 x, float2 y) { return x - y * floor(x / y); }
float3 glslMod(float3 x, float3 y) { return x - y * floor(x / y); }
float4 glslMod(float4 x, float4 y) { return x - y * floor(x / y); }
float2 glslMod(float2 x, float  y) { return x - y * floor(x / y); }
float3 glslMod(float3 x, float  y) { return x - y * floor(x / y); }
float4 glslMod(float4 x, float  y) { return x - y * floor(x / y); }

// ---------------------------------------------------------------------

#define PI 3.14159
#define NUM_SEGMENTS 20.0
#define NUM_POINTS (NUM_SEGMENTS * 2.0)
#define STEP 1.0
//#define FIT_VERTICAL

void main() {
  float localTime = time + 20.0;
  float point = glslMod(floor(vertexId / 2.0) + glslMod(vertexId, 2.0) * STEP, NUM_SEGMENTS);
  float count = floor(vertexId / NUM_POINTS);
  float offset = count * sin(time * 0.01) + 5.0;
  float angle = point * PI * 2.0 / NUM_SEGMENTS + offset;
  float snd = floatSound.SampleLevel(vsaSampler, float2(count / 10000.0, 0), 0.0).a;  
  float radius = pow(count * 0.014, 1.0) + snd * 0.03;
  float c = cos(angle + localTime) * radius;
  float s = sin(angle + localTime) * radius;
  float orbitAngle =  pow(count * 0.025, 0.8);
  float innerRadius = pow(count * 0.0005, 1.2);
  float oC = cos(orbitAngle + count * 0.0001) * innerRadius;
  float oS = sin(orbitAngle + count * 0.0001) * innerRadius;

  #ifdef FIT_VERTICAL
    float2 aspect = float2(resolution.y / resolution.x, 1);
  #else
    float2 aspect = float2(1, resolution.x / resolution.y);
  #endif

  float2 xy = float2(
      oC + c,
      oS + s);
  gl_Position = float4(xy * aspect + mouse * 0.1, 0, 1);

  float b = clamp(40.0 + snd, 0.0, 1.0);
  float3 bk = float3(178.0 / 255.0, 23.0 / 255.0, 0);
  v_color = float4(lerp(bk, float3(0,0,0), b), 1);
}

// ---------------------------------------------------------------------

struct VSOutput {
  float4 position  : SV_Position;
  float4 color     : COLOR0;
  float  pointSize : PSIZE;
};

VSOutput vsMain(uint vertexIndex : SV_VertexID) {
  vertexId = (float)vertexIndex;
  main();

  VSOutput output;
  output.position  = gl_Position;
  output.color     = v_color;
  output.pointSize = gl_PointSize;
  return output;
}
