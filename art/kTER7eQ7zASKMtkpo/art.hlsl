void main() {
  // 2 points per line
  float lineId = floor(vertexId / 2.);
  float numLines = floor(vertexCount / 2.);
  float i = lineId / numLines * 3.; 
  float odd = glslMod(vertexId, 2.);
 
  // g.fillStyle='hsla('+360/(i%9)+t+',100%,50%,0.3)';
  float h = glslMod(i, 300.) + time;
  float s = 1.;
  float l = .5;
  v_color.rgb = hsl2rgb(float3(h,s,l));
  v_color.a = 0.3;
  v_color.rgb *= v_color.a;
  
  float lineOffset = floor(lineId / (numLines / 3.));
  gl_Position.x = frac(i + lineOffset * 0.331) * 2. - 1.;
  gl_Position.y = lerp(0., sin(i + i * 5. + time * 10.), odd);
  gl_Position.z = 0.;
  gl_Position.w = 1.;
}

// ---------------------------------------------------------------------

struct VSOutput {
  float4 position  : SV_Position;
  float4 color     : COLOR0;
  float  pointSize : PSIZE;
};

VSOutput vsMain(uint vertexIndex : SV_VertexID) {
  vertexId = (float)vertexIndex;
  main();

  VSOutput output;
  output.position  = gl_Position;
  output.color     = v_color;
  output.pointSize = gl_PointSize;
  return output;
}
