// grid by gman
// https://www.vertexshaderart.com/art/TYoTaksHA6DWsP4aD
//
// HLSL (vs_5_0) port of the GLSL ES 1.00 vertex shader in art.json,
// generated by build/gen-hlsl.js.
//
// Matrices hold the transpose of their GLSL counterparts so that column
// constructors and m[i] column indexing carry over unchanged; the
// difference lives in the multiplies, as HLSL's usual row vector
// convention (GLSL `M * v` is `mul(v, M)` here).

cbuffer VSAUniforms : register(b0) {
  float2 mouse;
  float2 resolution;
  float4 background;
  float  time;
  float  vertexCount;
  float2 soundRes;
  float  _dontUseDirectly_pointSize;
};

Texture2D<float4> volume     : register(t0);
Texture2D<float4> sound      : register(t1);
Texture2D<float4> floatSound : register(t2);
Texture2D<float4> touch      : register(t3);
SamplerState      vsaSampler : register(s0);

// gl_Position / gl_PointSize / v_color are globals here for the same reason
// they're globals in GLSL: helper functions in these shaders write to them.
static float  vertexId;
static float4 gl_Position;
static float  gl_PointSize = 1.0;
static float4 v_color;

// GLSL mod() floors, HLSL fmod() truncates, so they disagree on negatives
float  glslMod(float  x, float  y) { return x - y * floor(x / y); }
float2 glslMod(float2 x, float2 y) { return x - y * floor(x / y); }
float3 glslMod(float3 x, float3 y) { return x - y * floor(x / y); }
float4 glslMod(float4 x, float4 y) { return x - y * floor(x / y); }
float2 glslMod(float2 x, float  y) { return x - y * floor(x / y); }
float3 glslMod(float3 x, float  y) { return x - y * floor(x / y); }
float4 glslMod(float4 x, float  y) { return x - y * floor(x / y); }

// ---------------------------------------------------------------------

/* ⏆ */



































































float3 hsv2rgb(float3 c) {
  c = float3(c.x, clamp(c.yz, 0., 1.));
  float4 K = float4(1., 2. / 3., 1. / 3., 3.);
  float3 p = abs(frac(c.xxx + K.xyz) * 6. - K.www);
  return c.z * lerp(K.xxx, clamp(p - K.xxx, 0., 1.), c.y);
}

float select(float v, float t) {
  return step(t * 0.9, v) * step(v, t * 1.1);
}

void main() {
  float GRID_YOFF = 1./40.;
  float GRID_DOWN = 17.;
  float GRID_ACROSS = 64.0;
  float NUM_PER_DOWN = GRID_DOWN * 2.;
  float NUM_PER_ACROSS = GRID_ACROSS * 2.;
  float NUM_PER_GRID = NUM_PER_DOWN + NUM_PER_ACROSS;
  float NUM_GRIDS = 4.;
  float NUM_GRID_TOTAL = NUM_PER_GRID * NUM_GRIDS;
  float NUM_POINTS = (vertexCount - NUM_GRID_TOTAL) / 4.;
  float NUM_SEGMENTS = NUM_POINTS / 2.;
  
  
  float id = vertexId - NUM_GRID_TOTAL;
  
  // produces 0,1, 1,2, 2,3, ...
  float point = floor(glslMod(id, NUM_POINTS) / 2.0) + glslMod(id, 2.0);
  // line count
  float grid = floor(id / NUM_POINTS);

  float u = point / (NUM_SEGMENTS - 1.);    // 0 <-> 1 across line
  float v = grid / NUM_GRIDS;      // 0 <-> 1 by line

  float snd0 = sound.SampleLevel(vsaSampler, float2(u * 1., 0), 0.0).a;
  float snd1 = sound.SampleLevel(vsaSampler, float2(u * 0.5, 0), 0.0).a;
  float snd2 = sound.SampleLevel(vsaSampler, float2(u * 0.25, 0), 0.0).a;
  float snd3 = sound.SampleLevel(vsaSampler, float2(u * 0.125, 0), 0.0).a;
  
  float s = 
    snd0 * select(grid, 0.) + 
    snd1 * select(grid, 1.) +
    snd2 * select(grid, 2.) + 
    snd3 * select(grid, 3.) +
    0.;
  
  float x = u * 2.0 - 1.0;
  float y = v * 2.0 - 1.0;
  float2 xy = float2(
      x,
      s * 0.4 + y + GRID_YOFF);
  gl_Position = float4(xy, 0, 1);
  
  float hue = grid * 0.25;
  float sat = 1.0;
  float val = 1.0;
  
  if (id < 0.0) {
    if (vertexId < NUM_PER_DOWN * NUM_GRIDS) {
      float hgx = glslMod(vertexId, 2.0);
      float hgy = glslMod(floor(vertexId / 2.), GRID_DOWN);
      float hgId = floor(vertexId / NUM_PER_DOWN);
      gl_Position = float4(
        hgx * 2. - 1.,
        hgy / (GRID_DOWN - 1.) * 0.4 +  
        (hgId / NUM_GRIDS * 2. - 1.) + GRID_YOFF,
        0.1,
        1);
      
      hue = hgId * 0.25;
      sat = 0.5;
      val = 0.3;
    } else {
      float vid = vertexId - NUM_PER_DOWN * NUM_GRIDS;
      float vgy = glslMod(vid, 2.0);
      float vgx = glslMod(floor(vid / 2.), GRID_ACROSS);
      float vgId = floor(vid / NUM_PER_ACROSS);
      gl_Position = float4(
        ((vgx / GRID_ACROSS) * 2. - 1.) * pow(2., vgId),
        vgy * 0.4 +  
        (vgId / NUM_GRIDS * 2. - 1.) + GRID_YOFF,
        0.1,
        1);
      
      hue = vgId * 0.25;
      sat = 0.5;
      val = 0.3;
      
    }
  }
  
  
  v_color = float4(hsv2rgb(float3(hue, sat, val)), 1);
}

// ---------------------------------------------------------------------

struct VSOutput {
  float4 position  : SV_Position;
  float4 color     : COLOR0;
  float  pointSize : PSIZE;
};

VSOutput vsMain(uint vertexIndex : SV_VertexID) {
  vertexId = (float)vertexIndex;
  main();

  VSOutput output;
  output.position  = gl_Position;
  output.color     = v_color;
  output.pointSize = gl_PointSize;
  return output;
}
