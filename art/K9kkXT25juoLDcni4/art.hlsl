// wip3 by gman
// https://www.vertexshaderart.com/art/K9kkXT25juoLDcni4
//
// HLSL (vs_5_0) port of the GLSL ES 1.00 vertex shader in art.json,
// generated by build/gen-hlsl.js.
//
// Matrices hold the transpose of their GLSL counterparts so that column
// constructors and m[i] column indexing carry over unchanged; the
// difference lives in the multiplies, as HLSL's usual row vector
// convention (GLSL `M * v` is `mul(v, M)` here).

cbuffer VSAUniforms : register(b0) {
  float2 mouse;
  float2 resolution;
  float4 background;
  float  time;
  float  vertexCount;
  float2 soundRes;
  float  _dontUseDirectly_pointSize;
};

Texture2D<float4> volume     : register(t0);
Texture2D<float4> sound      : register(t1);
Texture2D<float4> floatSound : register(t2);
Texture2D<float4> touch      : register(t3);
SamplerState      vsaSampler : register(s0);

// gl_Position / gl_PointSize / v_color are globals here for the same reason
// they're globals in GLSL: helper functions in these shaders write to them.
static float  vertexId;
static float4 gl_Position;
static float  gl_PointSize = 1.0;
static float4 v_color;

// GLSL mod() floors, HLSL fmod() truncates, so they disagree on negatives
float  glslMod(float  x, float  y) { return x - y * floor(x / y); }
float2 glslMod(float2 x, float2 y) { return x - y * floor(x / y); }
float3 glslMod(float3 x, float3 y) { return x - y * floor(x / y); }
float4 glslMod(float4 x, float4 y) { return x - y * floor(x / y); }
float2 glslMod(float2 x, float  y) { return x - y * floor(x / y); }
float3 glslMod(float3 x, float  y) { return x - y * floor(x / y); }
float4 glslMod(float4 x, float  y) { return x - y * floor(x / y); }

// ---------------------------------------------------------------------

#define PI 3.14159
#define ACROSS 10.
#define DOWN 10.
#define PER_AREA ((ACROSS + 1.) * (DOWN + 1.) * 10.)

float3 hsv2rgb(float3 c) {
  c = float3(c.x, clamp(c.yz, 0.0, 1.0));
  float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
  float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
  return c.z * lerp(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}

float4 area(float vertexId, float areaId) {
  // 0, 2, 2, 4, 4, 1, 3, 3, 0
  float pointId = glslMod((floor(vertexId / 2.) + glslMod(vertexId, 2.)) * 2., 5.);
  float thingId = floor(vertexId / 10.);
  float col = glslMod(thingId, ACROSS + 1.);
  float row = floor(thingId / (ACROSS + 1.));
  float u = col / ACROSS;
  float v = row / DOWN;
  float x = u * 2. - 1.;
  float y = v * 2. - 1.;
  
  float d = length(float2(x, y));
  float su = glslMod(PI * 2.  + atan2(y ,x) + areaId / .8 * PI * 2. + time, PI * 2.) / (PI * 2.);
  float sv = d * 0.1;
  float snd = sound.SampleLevel(vsaSampler, float2(su * 0.25 / 8. * areaId, sv), 0.0).a;
  
  float r = 0.04 + pow(snd, 3.) * 0.15;
  float a = pointId / 5. * PI * 2. + thingId * 0.05 + time * 2.;
  float2 cs = float2(cos(a), sin(a));
  float2 xy = cs * r;
  float2 aspect = float2(1, resolution.x / resolution.y);
  
  float hue = (time * 0.01) + areaId / 8.;
  
  return float4(
    float2(x, y) * 1.0 + xy * aspect,
    snd,
    hue);
}

void main() {
  gl_PointSize = 4.0;

  float areaId = floor(vertexId / PER_AREA);
  float aCol = glslMod(areaId, 4.);
  float aRow = floor(areaId / 4.);
  float ax = (aCol + 0.5) / 4. * 2. - 1.;
  float ay = (aRow + 0.5) / 2. * 1.8 - 0.9;
  float avId = glslMod(vertexId, PER_AREA); 
  
  float4 a = area(avId, areaId);
  
  gl_Position = float4(a.xy * float2(0.25, 0.4) + float2(ax, ay), 0, 1);
  float snd = a.z;
  float hue = a.w;
  v_color = float4(lerp(hsv2rgb(float3(hue, 1, snd)), float3(1,1,1), 0.0), 1.0);
  v_color = float4(v_color.rgb * v_color.a, v_color.a);
}

// ---------------------------------------------------------------------

struct VSOutput {
  float4 position  : SV_Position;
  float4 color     : COLOR0;
  float  pointSize : PSIZE;
};

VSOutput vsMain(uint vertexIndex : SV_VertexID) {
  vertexId = (float)vertexIndex;
  main();

  VSOutput output;
  output.position  = gl_Position;
  output.color     = v_color;
  output.pointSize = gl_PointSize;
  return output;
}
