// res-indy point cloud vs spheres by gman
// https://www.vertexshaderart.com/art/xbnz2uAnWG7hSF8jC
//
// HLSL (vs_5_0) port of the GLSL ES 1.00 vertex shader in art.json,
// generated by build/gen-hlsl.js.
//
// Matrices hold the transpose of their GLSL counterparts so that column
// constructors and m[i] column indexing carry over unchanged; the
// difference lives in the multiplies, as HLSL's usual row vector
// convention (GLSL `M * v` is `mul(v, M)` here).

cbuffer VSAUniforms : register(b0) {
  float2 mouse;
  float2 resolution;
  float4 background;
  float  time;
  float  vertexCount;
  float2 soundRes;
  float  _dontUseDirectly_pointSize;
};

// gl_Position / gl_PointSize / v_color are globals here for the same reason
// they're globals in GLSL: helper functions in these shaders write to them.
static float  vertexId;
static float4 gl_Position;
static float  gl_PointSize = 1.0;
static float4 v_color;

// ---------------------------------------------------------------------

/*
   point cloud vs spheres by Kabuto

   Recreated this well-known demo effect. A bit tricky without being able to store history for points, so it's just computed again and again for each render pass
*/

float3 posf2(float t, float i) {
	return float3(
      sin(t+i*.9553) +
      sin(t*1.311+i) +
      sin(t*1.4+i*1.53) +
      sin(t*1.84+i*.76),
      sin(t+i*.79553+2.1) +
      sin(t*1.311+i*1.1311+2.1) +
      sin(t*1.4+i*1.353-2.1) +
      sin(t*1.84+i*.476-2.1),
      sin(t+i*.5553-2.1) +
      sin(t*1.311+i*1.1-2.1) +
      sin(t*1.4+i*1.23+2.1) +
      sin(t*1.84+i*.36+2.1)
	)*.2;
}

float3 posf0(float t) {
  return posf2(t,-1.)*3.5;
}

float3 posf(float t, float i) {
  return posf2(t*.3,i) + posf0(t);
}

float3 push(float t, float i, float3 ofs, float lerpEnd) {
  float3 pos = posf(t,i)+ofs;
  
  float3 posf = frac(pos+.5)-.5;
  
  float l = length(posf)*2.;
  return (- posf + posf/l)*(1.-smoothstep(lerpEnd,1.,l));
}

void main() {
  // more or less random movement
  float t = time*.20;
  float i = vertexId+sin(vertexId)*100.;

  float3 pos = posf(t,i);
  float3 ofs = float3(0);
  for (float f = -10.; f < 0.; f++) {
	  ofs += push(t+f*.05,i,ofs,2.-exp(-f*.1));
  }
  ofs += push(t,i,ofs,.999);
  
  pos -= posf0(t);
  
  pos += ofs;
  
  
  pos.yz = mul(float2x2(.8,.6,-.6,.8), pos.yz);
  pos.xz = mul(float2x2(.8,.6,-.6,.8), pos.xz);
  
  pos *= 1.;
  

  pos.z += .7;
  
  pos.xy *= .6/pos.z;
  
  gl_Position = float4(pos.x, pos.y*resolution.x/resolution.y, pos.z*.1, 1);
  gl_PointSize = 1./pos.z;

  v_color = float4(abs(ofs/max(length(ofs),1e-9))*.3+.7,1);
  gl_PointSize *= resolution.x / 1600.0;
}

// ---------------------------------------------------------------------

struct VSOutput {
  float4 position  : SV_Position;
  float4 color     : COLOR0;
  float  pointSize : PSIZE;
};

VSOutput vsMain(uint vertexIndex : SV_VertexID) {
  vertexId = (float)vertexIndex;
  main();

  VSOutput output;
  output.position  = gl_Position;
  output.color     = v_color;
  output.pointSize = gl_PointSize;
  return output;
}
