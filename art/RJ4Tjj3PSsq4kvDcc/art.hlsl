#define PI radians( 180.0 )

float3 hsv2rgb(float3 c) {
  c = float3(c.x, clamp(c.yz, 0.0, 1.0));
  float4 K = float4(1.0, 2.0 / 3.0, 1.0 / 3.0, 3.0);
  float3 p = abs(frac(c.xxx + K.xyz) * 6.0 - K.www);
  return c.z * lerp(K.xxx, clamp(p - K.xxx, 0.0, 1.0), c.y);
}


float3 GetSunDir()
{
  	return normalize( float3( 1.0, 0.3, -0.5 ) );
}


void GetQuadInfo( const float vertexIndex, out float2 quadVertId, out float quadId )
{
    float twoTriVertexIndex = glslMod( vertexIndex, 6.0 );
    float triVertexIndex = glslMod( vertexIndex, 3.0 );
  
    if 		( twoTriVertexIndex < 0.5 ) quadVertId = float2( 0.0, 0.0 );
    else if	( twoTriVertexIndex < 1.5 )	quadVertId = float2( 1.0, 0.0 );
    else if ( twoTriVertexIndex < 2.5 )	quadVertId = float2( 0.0, 1.0 );
    else if ( twoTriVertexIndex < 3.5 )	quadVertId = float2( 1.0, 0.0 );
    else if ( twoTriVertexIndex < 4.5 )	quadVertId = float2( 1.0, 1.0 );
    else 								quadVertId = float2( 0.0, 1.0 );

    quadId = floor( vertexIndex / 6.0 );
}


void GetQuadTileInfo( const float2 quadVertId, const float quadId, const float2 vDim, out float2 vQuadTileIndex, out float2 vQuadUV )
{
    vQuadTileIndex.x = floor( glslMod( quadId, vDim.x ) );
    vQuadTileIndex.y = floor( quadId / vDim.x );

  	vQuadUV.x = floor(quadVertId.x + vQuadTileIndex.x);
    vQuadUV.y = floor(quadVertId.y + vQuadTileIndex.y);

    vQuadUV = vQuadUV * (1.0 / vDim);
}


void GetQuadTileInfo( const float vertexIndex, const float2 vDim, out float2 vQuadTileIndex, out float2 vQuadUV )
{
  	float2 quadVertId;
  	float quadId;
	GetQuadInfo( vertexIndex, quadVertId, quadId );  
  	GetQuadTileInfo( quadVertId, quadId, vDim, vQuadTileIndex, vQuadUV );   
}


void GetMatrixFromZY( const float3 vZ, const float3 vY, out float3x3 m )
{
   float3 vX = normalize( cross( vY, vZ ) );
   float3 vOrthoY = normalize( cross( vZ, vX ) );
   m[0] = vX;
   m[1] = vOrthoY;
   m[2] = vZ;
}


void GetMatrixFromZ( float3 vZAxis, out float3x3 m )
{
  	float3 vZ = normalize(vZAxis);
   	float3 vY = float3( 0.0, 1.0, 0.0 );
  	if ( abs(vZ.y) > 0.99 )
    {
       vY = float3( 1.0, 0.0, 0.0 );
    }
  	GetMatrixFromZY( vZ, vY, m );
}


