float m1p1(float v) {
  return v * 2. - 1.;
}

float inRange(float v, float minV, float maxV) {
  return step(minV, v) * step(v, maxV);
}

float at(float v, float target) {
  return inRange(v, target - 0.1, target + 0.1);
}


void GetCubePosition( float fVertexId, float fCubeId, out float4x4 mat, out float4 vCubeCol, out float snd)
{  
  	float fSeed = fCubeId;
  	float fPositionBase = fCubeId;
  	float fSize = 1.0;

  	float3 vCubeOrigin = float3( 0.0, 0.0, 0.0 );

    float posId = floor(fCubeId / 4.);
    float side = m1p1(glslMod(floor(fCubeId / 2.), 2.));
    float across = 32.;
    float down = 20.;
    float u = glslMod(posId, across) / across;
    float v = floor(posId / across) / down;
    float lng = u * PI * 2.;
    float lat = v * PI;

    float uu = abs(m1p1(u));
    float ur = uu; //cos(PI * -0.25) * u + sin(PI * -0.25) * v;
    float vr = v; //sin(PI * -0.25) * v  - cos(PI * -0.25) * u;
    snd = sound.SampleLevel(vsaSampler, float2(lerp(0.05, 0.25, ur), vr * 0.05), 0.0).a;
    float glow = glslMod(fCubeId, 2.);
    float glowScale = pow(snd, 5.) * glow * 6.;
    //vCubeOrigin.z += pow(snd, 10.0) * 10.0;
    float fScale = 0.1 + glowScale * 0.2;//mix(0.1, 0.6, sin(lat)) * snd * 1.02;
    vCubeOrigin.x = side * 6. * (1. - pow(snd, 5.) * 2.);
    vCubeOrigin.y = m1p1(v) * 10.;
    vCubeOrigin.z = m1p1(u) * 10.; 
  
    float axisId = floor(fVertexId / 12.);
    
  
    mat  = ident();
 // 	mat *= rotZ(lng);
 // 	mat *= rotY(lat);
    mat = mul(trans(vCubeOrigin), mat);
    mat = mul(scale(float3(
      fScale * lerp(1., 0.33, glow * at(axisId, 1.)), 
      fScale * lerp(1., 0.33, glow * at(axisId, 2.)),
      fScale * lerp(1., 0.33, glow * at(axisId, 0.)))), mat);
  
  	float3 vRandCol;

    float s2 = sound.SampleLevel(vsaSampler, float2(lerp(0.015, 0.015, u), v * 0.1), 0.0).a;
  
    vCubeCol.xyz = lerp(float3(0.0), float3(1,1,1), pow(s2, 40.0));  
    vCubeCol.xyz = lerp(vCubeCol.xyz, float3(1,0,0), step(0.95,s2));
    vCubeCol.xyz = float3(0,0,1);

  #if 0
    vCubeCol.xyz = hsv2rgb(float3(axisId / 3., 1, 1));
    vCubeCol.xyz = 
      at(axisId, 0.) * float3(1,1,0) * 1. +
      at(axisId, 1.) * float3(1,0,1) * 1. + 
      at(axisId, 2.) * float3(0,1,1) * 1. ;
  #endif
}


void main()
{ 
  	SceneVertex sceneVertex;
  
  	float2 vMouse = mouse;
  
  	float fov = 1.5;
  
  	float animTime = time;
  
  	float orbitAngle = animTime * 0.3456 + 4.0;
  	float elevation = -2.2 + (sin(animTime * 0.223 - PI * 0.5) * 0.5 + 0.5) * 0.5;
  	float fOrbitDistance = 25.0 + (cos(animTime * 0.2345) * 0.5 + 0.5 ) * 10.0;
  
  	float3 vCameraTarget = float3( 0.0, 1.0, 0.0 );
  	float3 vCameraPos = vCameraTarget + float3( sin(orbitAngle) * cos(elevation), sin(elevation * 1.11), cos(orbitAngle * 0.97) * cos(elevation) ) * fOrbitDistance;
  	float3 vCameraUp = float3( 0.1, 1.0, 0.0 );
  
  	float3 vCameraForwards = normalize(vCameraTarget - vCameraPos);
  
  	float3x3 mCamera;
    GetMatrixFromZY( vCameraForwards, normalize(vCameraUp), mCamera );
  
  	float vertexIndex = vertexId;
  
  
    float fCubeId = floor( vertexIndex / g_cubeVertexCount );
    float fCubeVertex = glslMod( vertexIndex, g_cubeVertexCount );

      float4x4 mCube;
      float4 vCubeCol;
      float snd;

      GetCubePosition( fCubeVertex, fCubeId, mCube, vCubeCol, snd );

      GenerateCubeVertex( fCubeId, fCubeVertex, mCube, vCubeCol, vCameraPos, sceneVertex );


    // Fianl output position
	float3 vViewPos = sceneVertex.vWorldPos;
    vViewPos -= vCameraPos;
  	vViewPos =  mul(mCamera, vViewPos);
  	
  	float2 vFov = float2( 1.0, resolution.x / resolution.y ) * fov;
  	float2 vScreenPos = vViewPos.xy * vFov;

	gl_Position = float4( vScreenPos.xy, -1.0, vViewPos.z );
    
    float glow = glslMod(fCubeId, 2.);
  
  	// Final output color
  	float fExposure = min( gExposure, time * 0.1 );
  	float4 vFinalColor = float4(sqrt( float3(1.0) - exp2( sceneVertex.vColor.xyz * -fExposure ) ), sceneVertex.vColor.a);
    vFinalColor = lerp(vFinalColor, float4(1,1,1,0.9), glow);
  
  	v_color = float4(vFinalColor.xyz * vFinalColor.a, vFinalColor.a);
}

