float3 getCameraPos(float t) {
  return getCameraPoint(t);
}


void main()
{ 
  	float2 vMouse = mouse;
  
  	float fov = 1.5;
  
  	float animTime = time * 0.1;
  
    float cameraTime = time * 0.05;
    float3 vCameraPos = getCameraPos(cameraTime);
    vCameraPos.y = lerp(2., 22., p1m1(sin(cameraTime * 3.73)));
  
    float3 vCameraTarget = getCameraPos(cameraTime + 0.2);
    float3 vT2 = getCameraPos(cameraTime + 0.4);
    vCameraTarget.y = lerp(2., 22., p1m1(sin(cameraTime * 3.73 + 0.2)));
  	float3 vCameraUp = float3( 0.0, 1, 0);
    float slide = 1. - p1m1(dot(
      normalize(vCameraTarget.xz - vCameraPos.xz), 
      normalize(vT2.xz - vCameraTarget.xz)));
  
    float4x4 matC = trans(vCameraPos);
    matC = mul(rotY(atan2(
      vCameraPos.x - vCameraTarget.x, 
      vCameraPos.z - vCameraTarget.z)), matC);
    matC = mul(rotZ(-0.6 * slide), matC);
    matC = mul(rotX((vCameraPos.y - vCameraTarget.y) * -0.2), matC);
  
  	float vertexIndex = vertexId;
    float fCubeId = floor( vertexIndex / g_cubeVertexCount );
    float fCubeVertex = glslMod( vertexIndex, g_cubeVertexCount );

    float4x4 mCube;
    float4 vCubeCol;
    float3 vCubePos;
    float snd;

    GetCubePosition( fCubeVertex, fCubeId, mCube, vCubeCol, snd );

    GenerateCubeVertex( fCubeId, fCubeVertex, vCubeCol, vCameraPos, vCubePos );
  
  
    float4x4 mat = persp(radians(65.), resolution.x / resolution.y, 0.1, 1000.);
    mat = mul(inverse(matC), mat);//cameraLookAt(vCameraPos, vCameraTarget, vCameraUp);
    mat = mul(mCube, mat);
  
    gl_Position = mul(float4(vCubePos, 1), mat);

    
    float glow = glslMod(fCubeId, 2.);
  
    float4 color = float4(0,1,0,0.9);
    color = float4(hsv2rgb(float3(floor(glslMod(cameraTime, 4.)) / 8., 1, 1)), 1);
  	float4 vFinalColor = lerp(float4(0,0,0,1), color, glow);
  
  
  	v_color = float4(vFinalColor.xyz * vFinalColor.a, vFinalColor.a);
}

