// Oklab Color Space by gman
// https://www.vertexshaderart.com/art/cznhWtArrLFqxJgAf
//
// HLSL (vs_5_0) port of the GLSL ES 1.00 vertex shader in art.json,
// generated by build/gen-hlsl.js.
//
// Matrices hold the transpose of their GLSL counterparts so that column
// constructors and m[i] column indexing carry over unchanged; the
// difference lives in the multiplies, as HLSL's usual row vector
// convention (GLSL `M * v` is `mul(v, M)` here).

cbuffer VSAUniforms : register(b0) {
  float2 mouse;
  float2 resolution;
  float4 background;
  float  time;
  float  vertexCount;
  float2 soundRes;
  float  _dontUseDirectly_pointSize;
};

// gl_Position / gl_PointSize / v_color are globals here for the same reason
// they're globals in GLSL: helper functions in these shaders write to them.
static float  vertexId;
static float4 gl_Position;
static float  gl_PointSize = 1.0;
static float4 v_color;

// GLSL mod() floors, HLSL fmod() truncates, so they disagree on negatives
float  glslMod(float  x, float  y) { return x - y * floor(x / y); }
float2 glslMod(float2 x, float2 y) { return x - y * floor(x / y); }
float3 glslMod(float3 x, float3 y) { return x - y * floor(x / y); }
float4 glslMod(float4 x, float4 y) { return x - y * floor(x / y); }
float2 glslMod(float2 x, float  y) { return x - y * floor(x / y); }
float3 glslMod(float3 x, float  y) { return x - y * floor(x / y); }
float4 glslMod(float4 x, float  y) { return x - y * floor(x / y); }

// ---------------------------------------------------------------------

#define PI radians(180.)
#define NUM_SEGMENTS 2.0
#define NUM_POINTS (NUM_SEGMENTS * 2.0)
#define STEP 1.0

float cbrt(float n) {
  float x = 1.0;
  for (int i = 0; i < 10; ++i) {
    x = (2.0 * x + n / (x * x)) / 3.0;
  }
  return x;
}

float3 rgb2oklab(float3 c) 
{
    float l = dot(c, float3(0.4121656120, 0.5362752080, 0.0514575653));
    float m = dot(c, float3(0.2118591070, 0.6807189584, 0.1074065790));
    float s = dot(c, float3(0.0883097947, 0.2818474174, 0.6302613616));

    float l_ = cbrt(l);
    float m_ = cbrt(m);
    float s_ = cbrt(s);

    return float3(
        0.2104542553*l_ + 0.7936177850*m_ - 0.0040720468*s_,
        1.9779984951*l_ - 2.4285922050*m_ + 0.4505937099*s_,
        0.0259040371*l_ + 0.7827717662*m_ - 0.8086757660*s_);
}

float3 oklab2rgb(float3 c) 
{
    float l_ = c.x + 0.3963377774 * c.y + 0.2158037573 * c.z;
    float m_ = c.x - 0.1055613458 * c.y - 0.0638541728 * c.z;
    float s_ = c.x - 0.0894841775 * c.y - 1.2914855480 * c.z;

    float l = l_*l_*l_;
    float m = m_*m_*m_;
    float s = s_*s_*s_;

    return float3(
        + 4.0767245293*l - 3.3072168827*m + 0.2307590544*s,
        - 1.2681437731*l + 2.6093323231*m - 0.3411344290*s,
        - 0.0041119885*l - 0.7034763098*m + 1.7068625689*s);
}

float3 hsl2rgb(float3 c) {
  float C = c.y;
  float h = c.x;
  float a = C * cos(h * PI * 2.0);
  float b = C * sin(h * PI * 2.0);
  float L = c.z;
  return oklab2rgb(float3(L,a,b));
}

void main() {
  float across = floor(sqrt(vertexCount));
  float down = floor(vertexCount / across);
  
  float x = glslMod(vertexId, across);
  float y = floor(vertexId / across);
  
  float u = x / (across - 1.0);
  float v = y / (down - 1.0);
  
  float xu = u * 2.0 - 1.0;
  float yv = v * 2.0 - 1.0;
  
  gl_Position = float4(xu, yv, 0, 1);
  gl_PointSize = 10.0;

  v_color= float4(hsl2rgb(float3(u, 0.2, 1.)), 1);
  
}

// ---------------------------------------------------------------------

struct VSOutput {
  float4 position  : SV_Position;
  float4 color     : COLOR0;
  float  pointSize : PSIZE;
};

VSOutput vsMain(uint vertexIndex : SV_VertexID) {
  vertexId = (float)vertexIndex;
  main();

  VSOutput output;
  output.position  = gl_Position;
  output.color     = v_color;
  output.pointSize = gl_PointSize;
  return output;
}
