float3 gSunColor = float3(1.0, 1.0, 1.0) * 10.0;  

float3 gSkyTop =  float3( 0.1, 0.2, 0.8 ) * 0.5;
float3 gSkyBottom = float3( 0.5, 0.8, 1.0 ) * 1.5;

float3 gCubeColor = float3(1.0, 1.0, 1.0);
float gExposure = 1.0;

float gCubeColorRandom = 0.0;

#define MOVE_OUTWARDS

